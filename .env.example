# ============================================================
# ROCKWELL TAX & DIGITAL STRATEGIES INC.
# Environment Configuration Template (Copy to .env / Vercel)
# ============================================================

NODE_ENV=production

# ── 1. Separated Database Connections ────────────────────────
# Runtime connection string (use least-privilege rockwell_app_user in production)
DATABASE_URL=postgresql://rockwell_app_user:<password>@<prod-pooler-host>/neondb?sslmode=require
# Development / Staging runtime connection string
DEV_DATABASE_URL=postgresql://rockwell_app_user:<password>@<dev-pooler-host>/neondb?sslmode=require
# Schema-owner connection string used ONLY by CLI scripts (migrate-db.js / backup-db.js)
MIGRATION_DATABASE_URL=postgresql://neondb_owner:<password>@<prod-host>/neondb?sslmode=require

# ── 2. Admin Authentication & Session Security ───────────────
# Required: 64 cryptographically random bytes encoded as 128 hex characters
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ADMIN_SESSION_SECRET=
ADMIN_ALLOWED_EMAILS=info@rockwelltaxdigital.com,info@rockwelltax.com,info@rockwelldigital.com,kaelmendiola26@gmail.com

# ── 3. Email Routing (Resend) ────────────────────────────────
RESEND_API_KEY=
FROM_EMAIL=Rockwell Tax & Digital <notifications@rockwelltax.com>
# Exclusive recipient for all website inquiry notifications
INQUIRY_NOTIFICATION_EMAIL=info@rockwelltaxdigital.com

# ── 4. Cloudflare Turnstile Bot Protection ───────────────────
# Required in production (POST /api/inquiries fails closed if missing)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=rockwelltaxdigital.com,www.rockwelltaxdigital.com,rockwelltax.com,www.rockwelltax.com,rockwellwebsite.vercel.app

# Development-only Turnstile test keys (ignored when NODE_ENV=production)
DEV_TURNSTILE_SITE_KEY=1x00000000000000000000AA
DEV_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ── 5. Site Launch Gate Policy ───────────────────────────────
COMING_SOON_BLOCK_INQUIRIES=true
